# ───────────── Voyara API ─────────────
NODE_ENV=development
PORT=5001

# MongoDB — local or Atlas. (No Postgres/Prisma.)
MONGODB_URI=mongodb://127.0.0.1:27017/hrms
# Set true to boot an in-memory MongoDB (auto-seeded) when no local mongod is installed
USE_MEMORY_DB=false

# Auth — REQUIRED, at least 32 characters. Server refuses to start without it.
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# CORS + links
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Pricing
TAX_RATE=0.12
BASE_CURRENCY=INR

# ── Optional: AI providers (first configured wins; rules engine is the keyless fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Optional: richer live data
GOOGLE_PLACES_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
TAVILY_API_KEY=
EXA_API_KEY=

# ── Optional: email (booking confirmations). Leave blank to log to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Voyara <no-reply@voyara.travel>"
